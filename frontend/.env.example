# Copy to .env.local (or .env) and fill in.
#   cp .env.example .env.local
# These values are PUBLIC — they ship inside the JS bundle.
# Only the Supabase anon key is allowed here; never a service-role or DB key.

VITE_API_BASE_URL=http://localhost:5000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 'supabase' (default, real Google sign-in) or 'mock' (DEV ONLY:
# role picker + dev-mock API, never for production builds)
VITE_AUTH_MODE=supabase
