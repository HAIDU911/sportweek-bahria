# =============================================================================
# SportsWeek Manager — example environment (copy to .env and fill in)
#   cp .env.example .env
# =============================================================================
# ASP.NET Core reads these from the process environment.
# A double underscore "__" maps to a config section separator in appsettings.json.
# Never commit the filled-in .env file.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase / identity
# ---------------------------------------------------------------------------
# Project URL, e.g. https://your-project-ref.supabase.co
Supabase__Url=
# Expected JWT audience (Supabase issues "authenticated")
Supabase__Audience=authenticated
# Optional. Leave EMPTY for projects using asymmetric JWKS signing keys.
# Set only for legacy HS256 projects.
Supabase__JwtSecret=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string.
# Use the least-privilege `sportsweek_api` role created by migration 0005,
# not the dashboard/superuser account.
ConnectionStrings__Supabase=Host=db.your-project-ref.supabase.co;Port=5432;Database=postgres;Username=sportsweek_api;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true

# ---------------------------------------------------------------------------
# CORS — must match the frontend origin exactly
# ---------------------------------------------------------------------------
Cors__Origins__0=http://localhost:5173

# ---------------------------------------------------------------------------
# Sign-in policy
# ---------------------------------------------------------------------------
Auth__AllowedDomains__0=gmail.com
Auth__AllowedDomains__1=bahria.edu.pk

# Server-side role provisioning. The browser can NEVER choose a role;
# a user gets elevated rights only if their verified email is listed here.
Auth__Admins__0=admin@example.com
Auth__Scorers__0=scorer@example.com
Auth__Stakeholders__0=stakeholder@example.com

ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# Frontend (Vite) — these are public values baked into the bundle.
# Only the Supabase anon key belongs here. Never a service-role or DB key.
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:5000
# 'supabase' (default, real Google sign-in) or 'mock' (DEV ONLY, never production)
VITE_AUTH_MODE=supabase
